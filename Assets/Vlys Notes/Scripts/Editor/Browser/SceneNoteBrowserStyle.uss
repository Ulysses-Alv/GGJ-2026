.root {
    padding: 10px;
    flex-direction: column;
}

.search-title-container {
     border-radius: 6px;
    border-color: #454545;
    border-width: 1px;
    flex-direction: row;
    align-items: center;
   
    margin: 15px;
}

.label-title {
    min-width: 40px;
    -unity-text-align: middle-left;
    margin-left: 12px;
}

.filter-foldout{
  
    align-content: center;
}

.search-field-title {
    margin-right: 15px;
}
.title-container{
    margin-top: 10px;    
    margin-bottom: 10px;
}

#searchField {
    flex-grow: 1;
}

.notes-scroll {
    flex-grow: 1;
    margin-top: 15px;
    
    margin-right: 8px;
    margin-left: 8px;

    border-radius: 6px;
    border-width:1px;
    border-color: #454545;
    background-color: #313131;
}



.note-label {
    -unity-text-align: middle-left;
    flex-grow: 1;
}

.note-button {
    width: 80px;
}


.note-entry {
    flex-direction: column;
    padding: 10px;
    margin: 12px;
    border-bottom-width: 8px;
    border-bottom-color: #3a3a3a;
}

.note-entry > VisualElement {
    
    margin-bottom: 10px;
}


.note-entry Label {
    font-size: 12px;
    color: #d4d4d4;
}

.note-entry Button {
    width: 100px;
}



.note-entry {
     padding: 8px;
    margin-bottom: 8px;
    flex-direction: column;

    border-radius: 6px;
    border-width: 1px;
    border-color: #2a2a2a;
}

.note-dark {
    background-color: #5e5e5e;
}

.note-light {
    background-color: #484848;
}
.category-container {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 6px;
}

.category-container Toggle {
    margin-right: 8px;
}


.notes-scroll {
    flex-grow: 1;
}

.note-entry {
    flex-direction: column;
    padding: 6px;
    margin-bottom: 8px;
}


.note-middle-row {
    flex-direction: column;
    margin-top: 4px;
    
    border-radius: 8px;
    border-width: 1px;
    border-color: #4F4F4F;
}

.note-bottom-row {
    flex-direction: row;
    margin-top: 4px;
}


.note-top-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 8px;
    border-radius: 6px;
    border-width: 1px;
    border-color: #4F4F4F;
}

.note-title {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    -unity-text-align: upper-left;
    -unity-font-style: bold;
    padding-left: 10px;
    padding-right: 50px;
    margin-top: 12px;
    margin-bottom: 12px;
    border-right-width: 1px;
    border-right-color: #4F4F4F;
}

.note-category {
    flex-grow: 1;
    flex-basis: 200px;
    min-width: 150px;
    margin-left: 12px;
    margin-top: 12px;
    margin-bottom: 12px;
    border-right-width: 1px;
    border-right-color: #4F4F4F;
}

.note-status {
    flex-grow: 1;
    flex-basis: 200px;
    min-width: 150px;
    margin-left: 12px;
    margin-top: 12px;
    margin-bottom: 12px;
}

.note-spacer {
    flex-grow: 1;
}


.note-focus-button {
    width: 100px;
    height: 25px;
    margin-left: auto;
}




/* Alternating backgrounds */

.note-dark {
    background-color: #2b2b2b;
}

.note-light {
    background-color: #353535;
}
.metadata {
    flex-direction: row;
    align-items: center;
    margin: 10px;

    border-radius: 8px;
    border-width: 1px;
    border-color: #4F4F4F;
}

.metadata-item {
    margin: 10px;
}

.note-middle-row {
    flex-direction: column;
    align-items: stretch;
}


.note-position-transform {
    margin-bottom: 4px;
}

.note-position-item{
   margin-bottom: 10px;
   margin-top: 10px;
   margin-left: 10px;
   margin-right: 30px;
}

.separator-line {
    height: 2px;
    margin: 12px 8px;
    background-color: #2a2a2a;
}

