.root-container {
    padding: 6px;
}

.top-container {
    flex-direction: column;
    padding: 12px;
    margin-bottom: 10px;
    border-width: 1px;
    border-radius: 6px;
    border-color: #4F4F4F;
}

TextField, Label, EnumField, ObjectField, Vector3Field {
    margin-left: 6px;
    margin-right: 6px;
}

TextField {
    margin-top: 4px;
    margin-bottom: 4px;
}

TextField[multiline="true"], #textField, #newCommentField, .textArea {
    min-height: 100px;
}

.title-label {
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    flex-grow: 1;
    margin-bottom: 6px;
}

.locked-layout .title-label {
    font-size: 20px;
    -unity-text-align: middle-center;
    margin-bottom: 6px;
}

.status-row {
    flex-direction: row;
    align-items: center;
}

.status-icon {
    width: 16px;
    height: 16px;
    margin-left: 5px;
}

Button {
    height: 26px;
    margin-top: 3px;
    border-radius: 10px;
}

.button-normal {
    background-color: #4A90E2;
}

.button-delete {
    background-color: #913535;
}

ScrollView {
    height: 140px;
}

.readonly {
    opacity: 0.7;
}

.resizable-container {
    height: 50px;
    min-height: 50px;
    flex-direction: column;
    background-color: #3d3d3d;
}

.comments-foldout {
    margin-bottom: 10px;
}

#commentsList {
    flex-grow: 1;
}

.resize-handle {
    height: 6px;
    background-color: #444;
    cursor: resize-vertical;
}

.note-label {
    background-color: #2f2f2f;
    padding: 4px;
    border-radius: 4px;
}

.comment-label {
    background-color: #323232;
    padding: 8px;
    margin-bottom: 6px;
    border-left-width: 3px;
    border-left-color: #4caf50;
}

.comment-row {
    flex-direction: row;
    margin-bottom: 6px;
}

.comment-row.left {
    justify-content: flex-start;
}

.comment-row.right {
    justify-content: flex-end;
}

.comment-bubble {
    max-width: 70%;
    padding: 8px;
    border-radius: 8px;
    flex-direction: column;
    white-space: normal;
}

.comment-bubble.self {
    background-color: #1e88e5;
    color: white;
}

.comment-bubble.other {
    background-color: #424242;
    color: white;
}

.comment-author {
    font-size: 13px;
    margin-bottom: 2px;
    opacity: 1;
}

.comment-message {
    white-space: normal;
    margin-bottom: 4px;
}

.comment-timestamp {
    font-size: 10px;
    opacity: 0.6;
    align-self: flex-end;
}

.readonly-field{
    border-width: 1px;
    border-radius: 6px;
    border-color: #4F4F4F;
}

.readonly-comment {
    margin-top: 6px;
    margin-bottom: 6px;
    white-space: normal;
}

.locked-layout #titleField,
.locked-layout #textField {
    display: none;
}

.header-container {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 24px;
    padding: 0 4px;
    margin:10px 0;
}

.edit-icon-button {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    margin-left: 4px;
    margin-top: -10px;
}

.top-container-item {
    margin-top: 8px;
}
.metadata{
    margin: 10px;
    border-radius: 8px;
    border-width:1px;
    border-color: #4F4F4F;
}

.apply-changes{
    margin-bottom: 10px;
}

.metadata-item {
    margin: 10px;
}

.header-label{
    border-radius:6px;
}